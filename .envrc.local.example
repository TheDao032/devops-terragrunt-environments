# .envrc.local.example — copy to `.envrc.local` (git-ignored) and fill in secrets.
#   cp .envrc.local.example .envrc.local
#
# .envrc sources .envrc.local automatically. Put ONLY secrets / per-machine values here.

# Vault — needed once Vault is initialized (root or a scoped token).
# export VAULT_ADDR="https://vault.k3s.local"
# export VAULT_TOKEN="hvs.xxxxxxxx"
# export VAULT_MASTER_TOKEN="hvs.xxxxxxxx"

# Container registry + VCS secrets (feed the vault-secrets `secrets` map). The NON-secret
# counterparts (DOCKER_REGISTRY/USERNAME/EMAIL, GITHUB_USERNAME, ARTIFACTORY_REGISTRY) have
# defaults in .envrc — only override them there/here if they differ per machine.
# export DOCKER_TOKEN="dckr_pat_xxxxxxxx"
# export GITHUB_TOKEN="ghp_xxxxxxxx"
# export SSH_PRIVATE_KEY="$(cat "$HOME/.ssh/gitops_ed25519")"

# Social-login OAuth client secrets for trainer-service (SCRUM-235). Feed dev/env.hcl's
# "trainer/params" -> fitmate/dev/trainer/params. These REPLACE credentials that were committed
# in plaintext to the app repo since 2026-05-11, so they must never be inlined in any .hcl file.
# Unset = empty = that provider is DISABLED (config/local/config.yaml: "Leave clientId/clientSecret
# empty to disable a specific provider"), which is the correct fail-safe.
# export GOOGLE_CLIENTSECRET="GOCSPX-xxxxxxxx"
# export FACEBOOK_CLIENTSECRET="xxxxxxxx"

# Override the kubeconfig location if not using the default k3s lab path:
# export KUBECONFIG="$HOME/.kube/config"

# If you ever need bearer-token auth instead of client-cert (you don't, for k3s):
# export KUBE_TOKEN="$(kubectl -n kube-system create token some-admin-sa)"

# HCP Terraform API token — auth to app.terraform.io (org nthedao_org) for the remote backend.
# Create at: HCP → User Settings → Tokens. See docs/hcp-terraform-backend.md.
export TF_TOKEN_app_terraform_io="REPLACE_WITH_YOUR_HCP_API_TOKEN"

# Cloudflare API token — for the `cloudflare-tunnel` terragrunt unit (fitmate.me production domain).
# Permissions: Zone:DNS:Edit, Account:Cloudflare Tunnel:Edit, Account:Access: Apps and Policies:Edit,
# Zone:Zone:Read — scoped to the fitmate.me zone. Create at: https://dash.cloudflare.com/profile/api-tokens
# export CLOUDFLARE_API_TOKEN="REPLACE_WITH_YOUR_CLOUDFLARE_API_TOKEN"
